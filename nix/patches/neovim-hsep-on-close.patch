From b7d165c9b988301db8903baaaeb07796546dabe9 Mon Sep 17 00:00:00 2001
From: Riccardo Mazzarini <me@noib3.dev>
Date: Thu, 12 Nov 2026 00:37:13 +0800
Subject: [PATCH] fix(window): remove the separator above a closed bottom
 window

---
 src/nvim/window.c | 41 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 40 insertions(+), 1 deletion(-)

diff --git a/src/nvim/window.c b/src/nvim/window.c
index acad6f1..8879827 100644
--- a/src/nvim/window.c
+++ b/src/nvim/window.c
@@ -3432,6 +3432,13 @@ win_T *winframe_remove(win_T *win, int *dirp, tabpage_T *tp, frame_T **unflat_al
     frame_set_vsep(frp_close->fr_prev, false);
   }
 
+  // If this is a bottommost window with a global statusline, remove
+  // horizontal separators above.
+  if (global_stl_height() > 0 && win->w_hsep_height == 0
+      && frp_close->fr_parent->fr_layout == FR_COL && frp_close->fr_prev != NULL) {
+    frame_set_hsep(frp_close->fr_prev, false);
+  }
+
   // Remove this frame from the list of frames.
   frame_remove(frp_close);
 
@@ -3634,7 +3641,7 @@ void winframe_restore(win_T *wp, int dir, frame_T *unflat_altfr)
     if (global_stl_height() == 0 && wp->w_status_height == 0) {
       frame_add_statusline(frp->fr_prev);
     } else if (global_stl_height() > 0 && wp->w_hsep_height == 0) {
-      frame_add_hsep(frp->fr_prev);
+      frame_set_hsep(frp->fr_prev, true);
     }
   }
 
@@ -4104,6 +4111,38 @@ static void frame_set_vsep(const frame_T *frp, bool add)
   }
 }
 
+/// Add or remove the horizontal separator of windows at the bottom of "frp".
+/// Note: Does not check if there is room or whether the windows have a statusline!
+static void frame_set_hsep(const frame_T *frp, bool add)
+  FUNC_ATTR_NONNULL_ARG(1)
+{
+  if (frp->fr_layout == FR_LEAF) {
+    win_T *wp = frp->fr_win;
+    if (add && wp->w_hsep_height == 0) {
+      if (wp->w_height > 0) {           // don't make it negative
+        win_new_height(wp, wp->w_height - 1);
+      }
+      wp->w_hsep_height = 1;
+    } else if (!add && wp->w_hsep_height == 1) {
+      win_new_height(wp, wp->w_height + 1);
+      wp->w_hsep_height = 0;
+    }
+  } else if (frp->fr_layout == FR_ROW) {
+    // Handle all the frames in the row.
+    FOR_ALL_FRAMES(frp, frp->fr_child) {
+      frame_set_hsep(frp, add);
+    }
+  } else {
+    assert(frp->fr_layout == FR_COL);
+    // Only need to handle the last frame in the column.
+    frp = frp->fr_child;
+    while (frp->fr_next != NULL) {
+      frp = frp->fr_next;
+    }
+    frame_set_hsep(frp, add);
+  }
+}
+
 /// Add the horizontal separator to windows at the bottom of "frp".
 /// Note: Does not check if there is room or whether the windows have a statusline!
 static void frame_add_hsep(const frame_T *frp)
